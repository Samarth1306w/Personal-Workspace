# ==============================================================================
# SAM CODES - Unified Environment Variables & Credentials Schema (.env.example)
# ==============================================================================
# Copy this template to `.env.local` for local development.
# In production, configure these variables in the Vercel / hosting project settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & CLOUD STORAGE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic secret key for session HMAC signing (minimum 32 characters)
ADMIN_SECRET_KEY=your-secret-key-min-32-chars
# Comma-separated list of authorized master administrator emails
ADMIN_EMAILS=samarthknimangre@gmail.com,admin@example.dev

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Telegram Sales Qualifier & Agent Intelligence)
# ------------------------------------------------------------------------------
# Gemini API Key (supports gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-flash)
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT API (@samarth_master_bot & Notifications)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Samarth's personal Telegram Chat ID for real-time lead and system alerts
TELEGRAM_ADMIN_CHAT_ID=your-telegram-numeric-chat-id
# High-entropy secret token for Telegram webhook request authentication
TELEGRAM_WEBHOOK_SECRET=your-32-char-webhook-secret

# ------------------------------------------------------------------------------
# 5. X / TWITTER API v2 (Social Broadcaster & Client Inquiries)
# ------------------------------------------------------------------------------
X_CONSUMER_KEY=your-x-consumer-api-key
X_CONSUMER_SECRET=your-x-consumer-api-secret
X_BEARER_TOKEN=your-x-bearer-token
X_CLIENT_ID=your-x-oauth2-client-id
X_CLIENT_SECRET=your-x-oauth2-client-secret
X_USERNAME=Sam_CodeAI
X_ACCESS_TOKEN=your-user-access-token
X_ACCESS_TOKEN_SECRET=your-user-access-token-secret

# ------------------------------------------------------------------------------
# 6. PAYMENTS & COMMERCE (UPI Payment Gateway)
# ------------------------------------------------------------------------------
# Direct UPI ID for instant client onboarding deposits (e.g., Google Pay, PhonePe)
UPI_PAYMENT_ID=your-upi-id@bank

# ------------------------------------------------------------------------------
# 7. OUTBOUND LEAD GENERATION & CRM (Apollo & Google Sheets)
# ------------------------------------------------------------------------------
APOLLO_API_KEY=your-apollo-b2b-leads-api-key
CRM_SHEET_ID=your-google-sheet-spreadsheet-id

# ------------------------------------------------------------------------------
# 8. EMAIL DISPATCH & INTAKE NOTIFICATIONS (Resend & Gmail SMTP)
# ------------------------------------------------------------------------------
# Resend API Key for instant direct-to-inbox lead delivery
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="SAM CODES <onboarding@resend.dev>"
ADMIN_NOTIFY_EMAIL=samarthknimangre@gmail.com
# Gmail SMTP for 2-way direct outbound client pitches & follow-ups
GMAIL_USER=samarthknimangre@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
CRM_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
TARGET_NICHE=dental_clinics
PRIMARY_REGION=India

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH 2.0 (CRM Sheets Sync & Workspace API)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_ACCESS_TOKEN=your-google-access-token
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_TOKEN_EXPIRY=2026-10-01T00:00:00.000Z
GOOGLE_SCOPES=https://www.googleapis.com/auth/spreadsheets

# ------------------------------------------------------------------------------
# 9. GITHUB DEVELOPER AUTOMATION
# ------------------------------------------------------------------------------
GH_TOKEN=ghp_your-github-personal-access-token

# ------------------------------------------------------------------------------
# 10. WHATSAPP BRIDGE & OUTBOUND API
# ------------------------------------------------------------------------------
WHATSAPP_BRIDGE_SECRET=your-whatsapp-bridge-api-secret

# ------------------------------------------------------------------------------
# 11. UPSTASH REDIS (Serverless Distributed Rate Limiting & Edge Synchronization)
# ------------------------------------------------------------------------------
# REST URL and Bearer token from Upstash Redis console (https://console.upstash.com)
# When provided, rate limiting utilizes atomic sliding-window EVAL in Redis.
# When omitted, the app gracefully falls back to the in-memory sliding window limiter.
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ------------------------------------------------------------------------------
# 12. TELEPHONY & VOICE AGENT ENGINE (Twilio & Fast LLM Routers)
# ------------------------------------------------------------------------------
# Twilio Account SID and Auth Token for signature verification and SMS dispatch
TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Active Twilio phone number with voice & SMS capabilities (E.164 format)
TWILIO_PHONE_NUMBER=+18149613703
# Groq API Key for sub-100ms Llama 3.1 8B voice turn routing (free at console.groq.com)
GROQ_API_KEY=gsk_your-groq-api-key

